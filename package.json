{
  "name": "mekbay",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "gen-meta": "tsx scripts/generate-build-meta.ts",
    "gen-assets": "tsx scripts/generate-assets.ts",
    "gen-force-name-words": "tsx scripts/generate-force-name-words.ts",
    "gen-ratgenerator": "tsx scripts/ratgenerator_build_table.ts",
    "gen-bfs": "tsx scripts/generate-bfs-files.ts",
    "gen-sprites": "tsx scripts/generate-sprite-map.ts",
    "prerun": "npm run gen-meta && npm run gen-assets",
    "start": "ng serve --host 0.0.0.0",
    "build": "npm run prerun && ng build --configuration=production",
    "build:next": "npm run prerun && ng build --configuration=next",
    "test:ratgenerator": "tsx scripts/ratgenerator_build_table.test.ts",
    "test:force-name-words": "tsx scripts/generate-force-name-words.test.ts",
    "test:unit-report-oracles": "tsx scripts/unit-report-oracles.test.ts",
    "test:unit-diagnostics": "tsx scripts/unit-diagnostics.test.ts",
    "test:core-unit-assets": "tsx scripts/generate-core-unit-assets.test.ts",
    "test:core-unit-summary-archive": "tsx scripts/verify-core-unit-archive-summary.ts",
    "test:generated-assets": "tsx scripts/generated-asset-inventory.test.ts",
    "test:presentation-catalog-fixtures": "tsx scripts/presentation-catalog-fixtures.test.ts",
    "pack:presentation-catalog-fixtures": "tsx scripts/pack-presentation-catalog-fixtures.ts",
    "test:asset-pipeline": "npm run test:core-unit-assets && npm run test:generated-assets",
    "typecheck:asset-pipeline": "tsc -p scripts/tsconfig.asset-pipeline.json",
    "check:presentation-catalogs": "npm run typecheck:scripts && npm run test:presentation-catalog-fixtures",
    "check:asset-pipeline": "npm run typecheck:asset-pipeline && npm run test:asset-pipeline",
    "test:deploy-pipeline": "node --import tsx --test scripts/deploy-build.test.ts scripts/validate-deployed-core-assets.test.ts",
    "validate:deployed-core-assets": "tsx scripts/validate-deployed-core-assets.ts",
    "test:convergence-architecture": "tsx scripts/convergence-architecture.test.ts",
    "refresh:origin-main-delta": "tsx scripts/refresh-origin-main-delta.ts",
    "test:equipment-status-architecture": "tsx scripts/equipment-status-architecture.test.ts",
    "check:mek-domain-corpus": "npm run test:unit-report-oracles && npm run test:unit-diagnostics",
    "typecheck:equipment-status-profile": "tsc -p scripts/tsconfig.equipment-status-profile.json",
    "profile:equipment-status": "node --expose-gc --import tsx scripts/benchmark-equipment-status.ts",
    "profile:equipment-status:save": "npm run profile:equipment-status -- --output scripts/benchmarks/equipment-status-profile-baseline.json",
    "test:bfs-generator": "tsx scripts/bfs-generator.test.ts",
    "typecheck:bfs-generator": "tsc -p scripts/tsconfig.bfs.json",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "check:script-integrity": "npm run typecheck:scripts && npm run test:ratgenerator",
    "watch": "ng build --watch --configuration=development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.0.3",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/pwa": "^22.0.5",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "angularx-qrcode": "^22.0.1",
    "jszip": "^3.10.1",
    "tslib": "^2.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@types/jasmine": "^6.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jszip": "^3.4.1",
    "@types/node": "^26.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "fast-xml-parser": "^5.9.3",
    "jasmine-core": "^6.3.0",
    "js-yaml": "^5.2.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
